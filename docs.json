{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Spyro AI",
  "theme": "luma",
  "colors": {
    "primary": "#ec5a00",
    "light": "#ec5a00",
    "dark": "#ec5a00"
  },
  "logo": {
